{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent.local/schemas/agent-loop/project-profile.v1.json",
  "title": "Agent Loop project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "repository", "context_by_phase", "gates", "resources", "risk_probes"],
  "properties": {
    "schema_version": {"const": "agent-loop.project-profile.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "clone_layout": {"enum": ["plain", "bitbucket-server"], "description": "HTTPS path layout; omitted means plain namespace/name."},
    "repository_host": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "description": "Explicit implementation Git host; omitted means github.com, independent of the tracking Issue."},
    "delivery_mode": {"enum": ["automated-pr", "human-pr"]},
    "context_by_phase": {"type": "object"},
    "gates": {"type": "object"},
    "resources": {"type": "object"},
    "risk_probes": {"type": "array", "items": {"type": "string"}}
  }
}

