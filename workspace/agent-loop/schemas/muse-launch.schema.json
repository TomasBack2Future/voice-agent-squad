{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mediated source Muse Worker launch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "native_session_id",
    "agent_id",
    "dispatcher_agent_id",
    "controller_native",
    "controller_epoch",
    "coordination_executable",
    "ledger_directory",
    "client_executable",
    "workspace",
    "state_directory",
    "settings_file",
    "prompt_file",
    "model",
    "provider",
    "permission_mode",
    "reasoning_effort",
    "tool_runtime",
    "coordination_home",
    "claim_generation"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-loop.muse-launch.v1"
    },
    "native_session_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "dispatcher_agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "controller_native": {
      "type": "string",
      "minLength": 1
    },
    "controller_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "coordination_executable": {
      "type": "string",
      "pattern": "^/"
    },
    "ledger_directory": {
      "type": "string",
      "pattern": "^/"
    },
    "client_executable": {
      "type": "string",
      "pattern": "^/"
    },
    "workspace": {
      "type": "string",
      "pattern": "^/"
    },
    "state_directory": {
      "type": "string",
      "pattern": "^/"
    },
    "settings_file": {
      "type": "string",
      "pattern": "^/"
    },
    "prompt_file": {
      "type": "string",
      "pattern": "^/"
    },
    "model": {
      "const": "muse-spark-1.3-contributor"
    },
    "provider": {
      "const": "meta"
    },
    "permission_mode": {
      "const": "yolo"
    },
    "reasoning_effort": {
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "max_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 82800
    },
    "human_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "repository",
        "reference",
        "operations",
        "managed_review"
      ],
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:/#_.-]{1,200}$"
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "source",
              "test",
              "pull_request",
              "managed_review",
              "gated_merge",
              "issue_close"
            ]
          }
        },
        "managed_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "destination",
            "content"
          ],
          "properties": {
            "provider": {
              "const": "grok"
            },
            "destination": {
              "type": "string",
              "pattern": "^[A-Za-z0-9:/#_.-]{1,200}$"
            },
            "content": {
              "const": "source_diff_and_issue_contract_only"
            }
          }
        }
      }
    },
    "tool_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "context",
        "daemon_id",
        "image"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "pattern": "^/"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "daemon_id": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "coordination_home": {
      "type": "string",
      "pattern": "^/"
    },
    "claim_generation": {
      "type": "integer",
      "minimum": 1
    }
  }
}
